# Environment reference; the hub does not automatically load this file.
TMUX_MONITOR_LISTEN=127.0.0.1:8080
TMUX_MONITOR_DATA_DIR=.data
TMUX_MONITOR_ORIGIN=https://your-hub.your-tailnet.ts.net
# Exact names/IPs approved for future SSH connections. No wildcard matching.
TMUX_MONITOR_ALLOWED_SSH_HOSTS=laptop.your-tailnet.ts.net,100.100.100.10
TMUX_MONITOR_DEV=false
# Experimental Agent pairing and inventory. Requires production HTTPS via Serve.
TMUX_MONITOR_AGENT_ENABLED=false
# Agent heartbeat interval in seconds. Three missed intervals close the connection.
TMUX_MONITOR_AGENT_HEARTBEAT_SECONDS=15
# Experimental Agent PTY. Also requires both AGENT_ENABLED and TERMINAL_ENABLED.
TMUX_MONITOR_AGENT_TERMINAL_ENABLED=false
# Experimental read-only viewer. Read README sizing/access prerequisites first.
TMUX_MONITOR_TERMINAL_ENABLED=false
# Experimental read-only pane snapshot (source not yet tested).
TMUX_MONITOR_PANE_SNAPSHOT_ENABLED=false
# Experimental SSH/tmux3.8 mutations.
TMUX_MONITOR_MUTATIONS_ENABLED=false
# Untested create/kill additions; requires MUTATIONS_ENABLED as well.
TMUX_MONITOR_SESSION_LIFECYCLE_ENABLED=false
# Experimental window create/rename. Requires MUTATIONS_ENABLED.
TMUX_MONITOR_WINDOW_MUTATIONS_ENABLED=false
# Experimental window/pane removal and pane split. Requires MUTATIONS_ENABLED.
TMUX_MONITOR_LAYOUT_MUTATIONS_ENABLED=false
