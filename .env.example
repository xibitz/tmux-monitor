# Environment reference; the hub does not automatically load this file.
TMUX_MONITOR_LISTEN=127.0.0.1:8080
TMUX_MONITOR_DATA_DIR=.data
TMUX_MONITOR_ORIGIN=https://your-hub.your-tailnet.ts.net
# Exact names/IPs approved for future SSH connections. No wildcard matching.
TMUX_MONITOR_ALLOWED_SSH_HOSTS=laptop.your-tailnet.ts.net,100.100.100.10
TMUX_MONITOR_DEV=false
# Experimental read-only viewer. Read README sizing/access prerequisites first.
TMUX_MONITOR_TERMINAL_ENABLED=false
# Experimental SSH/tmux3.8 session rename; create/kill are not implemented.
TMUX_MONITOR_MUTATIONS_ENABLED=false
# Untested create/kill additions; requires MUTATIONS_ENABLED as well.
TMUX_MONITOR_SESSION_LIFECYCLE_ENABLED=false
