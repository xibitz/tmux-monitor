# Copy to /etc/tmux-monitor/hub.env and keep readable only by root.
TMUX_MONITOR_LISTEN=127.0.0.1:8080
TMUX_MONITOR_DATA_DIR=/var/lib/tmux-monitor
TMUX_MONITOR_ORIGIN=https://your-hub.your-tailnet.ts.net
TMUX_MONITOR_DEV=false
# Enable individual features after reviewing the README.
TMUX_MONITOR_ALLOWED_SSH_HOSTS=
TMUX_MONITOR_AGENT_ENABLED=false
TMUX_MONITOR_TERMINAL_ENABLED=false
TMUX_MONITOR_AGENT_TERMINAL_ENABLED=false
