[Unit]
Description=tmux monitor Agent for the current user

[Service]
Type=simple
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/tmux-monitor-agent run --credential-file %h/.config/tmux-monitor/agent.json
UMask=0077
NoNewPrivileges=yes
KillMode=mixed
TimeoutStopSec=20s

[Install]
WantedBy=default.target
